@model AcxiomCRM.Services.PaginatedList<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Follow-Up & Adherence Report</h3>
        <p class="text-muted small mb-0">Track upcoming, completed, and overdue follow-up interactions across sales accounts</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Reports
    </a>
</div>

<!-- Filters -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="FollowUpReport" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewBag.Status == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Type</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                    <option value="Demo" selected="@(ViewBag.Type == "Demo")">Demo</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">From</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">To</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                <a asp-action="FollowUpReport" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Target Account</th>
                    <th>Type</th>
                    <th>Scheduled Date</th>
                    <th>Remarks</th>
                    <th>Status</th>
                    <th>Outcome Notes</th>
                    <th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Items)
                {
                    var isOverdue = f.FollowUpDate < DateTime.UtcNow && f.Status == "Planned";
                    <tr class="@(isOverdue ? "table-danger" : "")">
                        <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "General")</td>
                        <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                        <td class="fw-semibold">@f.FollowUpDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-truncate" style="max-width: 200px;">@f.Remarks</td>
                        <td>
                            <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Missed" ? "bg-danger" : "bg-info text-dark")">
                                @f.Status
                            </span>
                        </td>
                        <td class="text-truncate" style="max-width: 200px;">@(f.OutcomeNotes ?? "-")</td>
                        <td>@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">No records match query.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
