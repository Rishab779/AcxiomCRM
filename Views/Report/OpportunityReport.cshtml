@model AcxiomCRM.Services.PaginatedList<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Sales Opportunities Report</h3>
        <p class="text-muted small mb-0">Financial deal pipeline, win probabilities, and close forecast dates</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Reports
    </a>
</div>

<!-- Filters -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="OpportunityReport" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Stage</label>
                <select name="stage" class="form-select form-select-sm">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Close Date From</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Close Date To</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter me-1"></i> Generate
                </button>
                <a asp-action="OpportunityReport" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Win %</th>
                    <th>Weighted Value</th>
                    <th>Close Target Date</th>
                    <th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Items)
                {
                    <tr>
                        <td>
                            <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-decoration-none">
                                @o.OpportunityName
                            </a>
                        </td>
                        <td>@o.Customer.CustomerName</td>
                        <td class="fw-bold">$@o.Amount.ToString("N0")</td>
                        <td>
                            <span class="badge @(o.Stage == "Won" ? "bg-success" : o.Stage == "Lost" ? "bg-danger" : "bg-primary")">
                                @o.Stage
                            </span>
                        </td>
                        <td>@o.Probability%</td>
                        <td class="text-secondary">$@o.WeightedAmount.ToString("N0")</td>
                        <td>@o.ExpectedCloseDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td>@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted">No records match query.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @Model.PageIndex of @Model.TotalPages (@Model.TotalCount total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="OpportunityReport" asp-route-page="@(Model.PageIndex - 1)" asp-route-stage="@ViewBag.Stage" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="OpportunityReport" asp-route-page="@p" asp-route-stage="@ViewBag.Stage" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="OpportunityReport" asp-route-page="@(Model.PageIndex + 1)" asp-route-stage="@ViewBag.Stage" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
