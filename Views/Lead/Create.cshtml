@model AcxiomCRM.ViewModels.LeadEditViewModel
@{
    ViewData["Title"] = "Create Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-funnel me-2 text-primary"></i>Create Sales Lead</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label">Contact / Lead Name <span class="required-indicator">*</span></label>
                            <input asp-for="LeadName" class="form-control" placeholder="e.g. Jane Doe" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Prospect organization" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address <span class="required-indicator">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="lead@company.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone Number <span class="required-indicator">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="+1-555-010-9988" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Source" class="form-label">Lead Source</label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="Cold Call">Cold Call</option>
                                <option value="Campaign">Campaign</option>
                                <option value="Trade Show">Trade Show</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label">Priority</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExpectedValue" class="form-label">Expected Value ($)</label>
                            <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="mb-4">
                            <label asp-for="AssignedTo" class="form-label">Assign To Executive</label>
                            <select asp-for="AssignedTo" asp-items="Model.UsersList" class="form-select">
                                <option value="">-- Assign Owner --</option>
                            </select>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
