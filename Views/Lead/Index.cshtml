@model AcxiomCRM.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Sales Leads";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Sales Leads</h3>
        <p class="text-muted small mb-0">Track prospect qualification, follow-ups, and convert leads to paying customers</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-funnel-fill me-1"></i> Add New Lead
    </a>
</div>

<!-- Filter Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Search Lead</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Name, Email, Phone, Company..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(Model.StatusFilter == "New")">New</option>
                    <option value="Contacted" selected="@(Model.StatusFilter == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(Model.StatusFilter == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(Model.StatusFilter == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(Model.StatusFilter == "Converted")">Converted</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Source</label>
                <select name="sourceFilter" class="form-select form-select-sm">
                    <option value="">All Sources</option>
                    <option value="Website" selected="@(Model.SourceFilter == "Website")">Website</option>
                    <option value="Referral" selected="@(Model.SourceFilter == "Referral")">Referral</option>
                    <option value="Cold Call" selected="@(Model.SourceFilter == "Cold Call")">Cold Call</option>
                    <option value="Campaign" selected="@(Model.SourceFilter == "Campaign")">Campaign</option>
                    <option value="Trade Show" selected="@(Model.SourceFilter == "Trade Show")">Trade Show</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Assigned Owner</label>
                <select name="assignedToFilter" asp-items="Model.UsersList" class="form-select form-select-sm">
                    <option value="">All Owners</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Data Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Lead Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Source</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Leads.Items)
                {
                    <tr>
                        <td><code>@l.LeadCode</code></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-semibold text-decoration-none">
                                @l.LeadName
                            </a>
                            <div class="small text-muted">@l.Email</div>
                        </td>
                        <td>@(l.CompanyName ?? "-")</td>
                        <td>
                            <span class="badge @(l.Status == "Converted" ? "bg-success" : l.Status == "Qualified" ? "bg-primary" : l.Status == "Contacted" ? "bg-info text-dark" : l.Status == "Lost" ? "bg-danger" : "bg-warning text-dark") badge-status">
                                @l.Status
                            </span>
                        </td>
                        <td>
                            <span class="badge @(l.Priority == "High" ? "bg-danger" : l.Priority == "Medium" ? "bg-primary" : "bg-secondary")">
                                @l.Priority
                            </span>
                        </td>
                        <td class="fw-semibold">$@l.ExpectedValue.ToString("N0")</td>
                        <td><small class="text-muted">@l.Source</small></td>
                        <td><small class="text-muted">@(l.AssignedUser?.FullName ?? "Unassigned")</small></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (l.Status != "Converted")
                                {
                                    <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-success" title="Convert Lead">
                                        <i class="bi bi-arrow-right-circle"></i> Convert
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Leads.Items.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-funnel fs-1 d-block mb-2 text-secondary"></i>
                            No leads found matching your search criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Leads.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">
                Showing page @Model.Leads.PageIndex of @Model.Leads.TotalPages (@Model.Leads.TotalCount total records)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Leads.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Leads.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.Leads.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Leads.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Leads.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Leads.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
