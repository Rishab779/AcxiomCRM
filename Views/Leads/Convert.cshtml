@model AcxiomCRM.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-arrow-right-circle-fill fs-3 me-3"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Convert Lead to Customer & Opportunity</h5>
                        <small class="opacity-75">Workflow: Converting prospect '@Model.LeadName' (@Model.LeadCode)</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- STEP 1: Customer Creation / Association -->
                    <div class="card mb-4 border">
                        <div class="card-header bg-light">
                            <h6 class="mb-0 fw-bold text-dark">
                                <span class="badge bg-primary me-2">Step 1</span> Customer Record Association
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="CreateNewCustomer" value="true" id="createNewCustRadio" onchange="toggleCustomerType()" checked />
                                    <label class="form-check-label fw-semibold" for="createNewCustRadio">Create New Customer Account</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="CreateNewCustomer" value="false" id="existingCustRadio" onchange="toggleCustomerType()" />
                                    <label class="form-check-label fw-semibold" for="existingCustRadio">Link to Existing Customer</label>
                                </div>
                            </div>

                            <!-- New Customer Fields -->
                            <div id="newCustomerSection">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label asp-for="CustomerName" class="form-label">Customer Name <span class="text-danger">*</span></label>
                                        <input asp-for="CustomerName" class="form-control" />
                                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="CompanyName" class="form-label">Company Name</label>
                                        <input asp-for="CompanyName" class="form-control" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                                        <input asp-for="Email" class="form-control" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                                        <input asp-for="Phone" class="form-control" />
                                        <span asp-validation-for="Phone" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="City" class="form-label">City</label>
                                        <input asp-for="City" class="form-control" placeholder="City" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="State" class="form-label">State / Region</label>
                                        <input asp-for="State" class="form-control" placeholder="State" />
                                    </div>
                                </div>
                            </div>

                            <!-- Existing Customer Dropdown -->
                            <div id="existingCustomerSection" class="d-none">
                                <div class="mb-3">
                                    <label asp-for="ExistingCustomerId" class="form-label">Select Existing Customer Account</label>
                                    <select asp-for="ExistingCustomerId" asp-items="Model.ExistingCustomersList" class="form-select">
                                        <option value="">-- Choose Existing Customer --</option>
                                    </select>
                                    <span asp-validation-for="ExistingCustomerId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: Initial Sales Opportunity -->
                    <div class="card mb-4 border">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold text-dark">
                                <span class="badge bg-primary me-2">Step 2</span> Initial Sales Opportunity
                            </h6>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="toggleOppSwitch" onchange="toggleOpportunityFields()" checked />
                                <label class="form-check-label small fw-semibold" for="toggleOppSwitch">Create Opportunity Deal</label>
                            </div>
                        </div>
                        <div class="card-body" id="opportunityFields">
                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label asp-for="OpportunityName" class="form-label">Opportunity Name <span class="text-danger">*</span></label>
                                    <input asp-for="OpportunityName" class="form-control" />
                                    <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="OpportunityAmount" class="form-label">Deal Amount ($) <span class="text-danger">*</span></label>
                                    <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="Stage" class="form-label">Pipeline Stage</label>
                                    <select asp-for="Stage" class="form-select">
                                        <option value="Qualification">Qualification</option>
                                        <option value="Proposal">Proposal</option>
                                        <option value="Negotiation">Negotiation</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="OpportunityProbability" class="form-label">Win Probability (%)</label>
                                    <input asp-for="OpportunityProbability" class="form-control" type="number" min="0" max="100" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date <span class="text-danger">*</span></label>
                                    <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                                    <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success btn-lg px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Complete Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleCustomerType() {
            const isNew = document.getElementById('createNewCustRadio').checked;
            document.getElementById('newCustomerSection').classList.toggle('d-none', !isNew);
            document.getElementById('existingCustomerSection').classList.toggle('d-none', isNew);
        }

        function toggleOpportunityFields() {
            const createOpp = document.getElementById('toggleOppSwitch').checked;
            document.getElementById('opportunityFields').classList.toggle('d-none', !createOpp);
        }
    </script>
}
