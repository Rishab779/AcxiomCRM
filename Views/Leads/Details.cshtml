@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = $"Lead - {Model.LeadName}";
}

<!-- Lead Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">@Model.LeadName</h3>
            <span class="badge @(Model.Status == "Converted" ? "bg-success" : Model.Status == "Qualified" ? "bg-primary" : Model.Status == "Contacted" ? "bg-info text-dark" : Model.Status == "Lost" ? "bg-danger" : "bg-warning text-dark")">
                @Model.Status
            </span>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
        </div>
        <p class="text-muted small mb-0 mt-1">
            <i class="bi bi-building me-1"></i>@(Model.CompanyName ?? "Individual Prospect") &bull; Captured @Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")
        </p>
    </div>

    <!-- Actions & Conversion -->
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> + Follow-Up
        </a>
        <a asp-controller="Activity" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-clock-history me-1"></i> + Activity
        </a>

        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm fw-bold">
                <i class="bi bi-arrow-right-circle-fill me-1"></i> Convert Lead
            </a>
        }
        else if (Model.ConvertedCustomerId.HasValue)
        {
            <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId.Value" class="btn btn-outline-success btn-sm">
                <i class="bi bi-person-check-fill me-1"></i> View Converted Customer
            </a>
        }
    </div>
</div>

<!-- Quick Status Progression Bar (if not converted) -->
@if (Model.Status != "Converted")
{
    <div class="card mb-4 bg-light border-0 shadow-sm">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="small fw-semibold text-secondary">
                <i class="bi bi-arrow-left-right me-1"></i> Quick Workflow Progression:
            </div>
            <div class="btn-group btn-group-sm">
                @if (Model.Status == "New")
                {
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="Contacted" />
                        <button type="submit" class="btn btn-outline-primary">Mark Contacted</button>
                    </form>
                }
                @if (Model.Status == "Contacted" || Model.Status == "New")
                {
                    <form asp-action="ChangeStatus" method="post" class="d-inline ms-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="Qualified" />
                        <button type="submit" class="btn btn-outline-success">Mark Qualified</button>
                    </form>
                }
                @if (Model.Status != "Lost")
                {
                    <form asp-action="ChangeStatus" method="post" class="d-inline ms-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="Lost" />
                        <button type="submit" class="btn btn-outline-danger">Mark Lost</button>
                    </form>
                }
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Lead Information -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Lead Information</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <small class="text-muted d-block">Email</small>
                        <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none">@Model.Email</a>
                    </li>
                    <li class="mb-2">
                        <small class="text-muted d-block">Phone</small>
                        <a href="tel:@Model.Phone" class="fw-semibold text-decoration-none">@Model.Phone</a>
                    </li>
                    <li class="mb-2">
                        <small class="text-muted d-block">Source</small>
                        <span class="badge bg-light text-dark border">@Model.Source</span>
                    </li>
                    <li class="mb-2">
                        <small class="text-muted d-block">Priority</small>
                        <span class="badge @(Model.Priority == "High" ? "bg-danger" : Model.Priority == "Medium" ? "bg-primary" : "bg-secondary")">@Model.Priority</span>
                    </li>
                    <li class="mb-2">
                        <small class="text-muted d-block">Expected Value</small>
                        <span class="fw-bold fs-5 text-dark">$@Model.ExpectedValue.ToString("N0")</span>
                    </li>
                    <li class="mb-0">
                        <small class="text-muted d-block">Assigned Representative</small>
                        <span class="fw-semibold">@(Model.AssignedUser?.FullName ?? "Unassigned")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Right Column: Scheduled Follow-Ups & Logged Activities -->
    <div class="col-lg-8">
        <!-- Follow-Ups -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2 text-primary"></i>Scheduled Follow-Ups</h6>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary btn-sm">Schedule</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Date & Time</th>
                            <th>Remarks</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                <td>@f.FollowUpDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="text-truncate" style="max-width: 250px;">@f.Remarks</td>
                                <td><span class="badge bg-info text-dark">@f.Status</span></td>
                                <td class="text-end">
                                    <a asp-controller="FollowUp" asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-secondary">View</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.FollowUps.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No follow-ups for this lead yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Activities -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Prospect Engagement Activities</h6>
                <a asp-controller="Activity" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary btn-sm">Log Activity</a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var act in Model.Activities)
                    {
                        <li class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge bg-secondary me-2">@act.ActivityType</span>
                                    <strong>@act.Subject</strong>
                                    @if (!string.IsNullOrEmpty(act.Description))
                                    {
                                        <p class="small text-muted mb-0 mt-1">@act.Description</p>
                                    }
                                </div>
                                <span class="small text-muted">@act.ActivityDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            </div>
                        </li>
                    }
                    @if (!Model.Activities.Any())
                    {
                        <li class="list-group-item text-center py-4 text-muted small">No engagement activities logged.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
