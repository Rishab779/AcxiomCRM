@model List<AcxiomCRM.Services.UserActivityReportItem>
@{
    ViewData["Title"] = "Staff Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Sales Team Activity & Effort Report</h3>
        <p class="text-muted small mb-0">Management scorecard tracking sales rep calls, meetings, emails, tasks, and deal generation</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Reports
    </a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Staff Member</th>
                    <th>Department</th>
                    <th class="text-center">Calls</th>
                    <th class="text-center">Meetings</th>
                    <th class="text-center">Emails</th>
                    <th class="text-center">Tasks</th>
                    <th class="text-center">Follow-Ups Planned</th>
                    <th class="text-center">Follow-Ups Done</th>
                    <th class="text-center">Deals Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.UserName</td>
                        <td>@(u.Role ?? "Sales")</td>
                        <td class="text-center"><span class="badge bg-primary bg-opacity-10 text-primary">@u.CallsCount</span></td>
                        <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success">@u.MeetingsCount</span></td>
                        <td class="text-center"><span class="badge bg-info bg-opacity-10 text-info">@u.EmailsCount</span></td>
                        <td class="text-center"><span class="badge bg-secondary bg-opacity-10 text-secondary">@u.TasksCount</span></td>
                        <td class="text-center">@u.FollowUpsPlanned</td>
                        <td class="text-center fw-bold text-success">@u.FollowUpsCompleted</td>
                        <td class="text-center fw-bold text-primary">@u.OpportunitiesCreated</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted">No staff activity data found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
