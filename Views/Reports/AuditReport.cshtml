@model AcxiomCRM.Services.PaginatedList<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "System Audit Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">System Security & Business Audit Report</h3>
        <p class="text-muted small mb-0">Append-only administrative trail of logins, security locks, credential updates, and CRM operations</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Reports
    </a>
</div>

<!-- Filters -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="AuditReport" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Target Entity / Module</label>
                <select name="entityName" class="form-select form-select-sm">
                    <option value="">All Entities</option>
                    <option value="Auth" selected="@(ViewBag.EntityName == "Auth")">Authentication</option>
                    <option value="Security" selected="@(ViewBag.EntityName == "Security")">Security</option>
                    <option value="User" selected="@(ViewBag.EntityName == "User")">User Administration</option>
                    <option value="Customer" selected="@(ViewBag.EntityName == "Customer")">Customer</option>
                    <option value="Lead" selected="@(ViewBag.EntityName == "Lead")">Lead</option>
                    <option value="Opportunity" selected="@(ViewBag.EntityName == "Opportunity")">Opportunity</option>
                    <option value="FollowUp" selected="@(ViewBag.EntityName == "FollowUp")">Follow-Up</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Action Performed</label>
                <input type="text" name="action" value="@ViewBag.Action" class="form-control form-control-sm" placeholder="e.g. Login, Create, Convert..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small">From Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">To Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                <a asp-action="AuditReport" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Record ID</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap small text-muted">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="fw-semibold">@(log.UserName ?? "Anonymous/System")</td>
                        <td>
                            <span class="badge @(log.Action.Contains("Lockout") || log.Action.Contains("Failed") ? "bg-danger" : log.Action.Contains("Login") ? "bg-success" : log.Action.Contains("Convert") ? "bg-primary" : "bg-secondary")">
                                @log.Action
                            </span>
                        </td>
                        <td><span class="badge bg-light text-dark border">@log.EntityName</span></td>
                        <td><code>@(log.RecordId ?? "-")</code></td>
                        <td class="small text-truncate" style="max-width: 350px;" title="@log.Details">
                            @(log.Details ?? log.NewValue ?? "-")
                        </td>
                        <td class="small text-muted">@(log.IpAddress ?? "127.0.0.1")</td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">No audit events match query.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @Model.PageIndex of @Model.TotalPages (@Model.TotalCount total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="AuditReport" asp-route-page="@(Model.PageIndex - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="AuditReport" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="AuditReport" asp-route-page="@(Model.PageIndex + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
