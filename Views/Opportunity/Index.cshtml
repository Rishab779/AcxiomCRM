@model AcxiomCRM.ViewModels.OpportunityListViewModel
@{
    ViewData["Title"] = "Sales Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Sales Opportunities</h3>
        <p class="text-muted small mb-0">Manage pipeline deals, stage progressions, and weighted revenue forecasts</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-graph-up me-1"></i> Add Opportunity
    </a>
</div>

<!-- Filter Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Search Deal</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Deal name, customer..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Pipeline Stage</label>
                <select name="stageFilter" class="form-select form-select-sm">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Deal Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(Model.StatusFilter == "Open")">Open</option>
                    <option value="Won" selected="@(Model.StatusFilter == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Assigned Owner</label>
                <select name="assignedToFilter" asp-items="Model.UsersList" class="form-select form-select-sm">
                    <option value="">All Owners</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Win %</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Opportunities.Items)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-decoration-none">
                                @o.OpportunityName
                            </a>
                        </td>
                        <td>
                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@o.CustomerId" class="text-muted text-decoration-none">
                                @o.Customer.CustomerName
                            </a>
                        </td>
                        <td class="fw-bold">$@o.Amount.ToString("N0")</td>
                        <td>
                            <span class="badge @(o.Stage == "Won" ? "bg-success" : o.Stage == "Lost" ? "bg-danger" : o.Stage == "Negotiation" ? "bg-warning text-dark" : "bg-primary") badge-status">
                                @o.Stage
                            </span>
                        </td>
                        <td>@o.Probability%</td>
                        <td class="text-secondary">$@o.WeightedAmount.ToString("N0")</td>
                        <td>
                            <small class="@(o.ExpectedCloseDate < DateTime.UtcNow && o.Status == "Open" ? "text-danger fw-bold" : "text-muted")">
                                @o.ExpectedCloseDate.ToLocalTime().ToString("MMM dd, yyyy")
                            </small>
                        </td>
                        <td><small class="text-muted">@(o.AssignedUser?.FullName ?? "Unassigned")</small></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="View Deal">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Opportunities.Items.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-graph-up fs-1 d-block mb-2 text-secondary"></i>
                            No opportunities found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Opportunities.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">
                Showing page @Model.Opportunities.PageIndex of @Model.Opportunities.TotalPages (@Model.Opportunities.TotalCount total records)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Opportunities.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Opportunities.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-stageFilter="@Model.StageFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.Opportunities.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Opportunities.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-stageFilter="@Model.StageFilter">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Opportunities.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Opportunities.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-stageFilter="@Model.StageFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
