@model AcxiomCRM.ViewModels.UserResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-warning">
            <div class="card-header bg-warning bg-opacity-25 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-key me-2 text-warning-emphasis"></i>Reset Password for @Model.FullName</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small">
                    As an administrator, you can issue a secure password reset for this user account. The event will be logged in the immutable audit log.
                </p>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="FullName" />
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">New Password <span class="required-indicator">*</span></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Min 8 characters" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="required-indicator">*</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning text-dark fw-semibold">
                            <i class="bi bi-shield-check me-1"></i> Apply Password Reset
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
