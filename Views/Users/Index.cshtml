@model AcxiomCRM.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">User & Role Administration</h3>
        <p class="text-muted small mb-0">System administrator controls for staff accounts, role permissions, and lockout management</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Create New User
    </a>
</div>

<!-- Filters -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small">Search User</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Name or email..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Role</label>
                <select name="roleFilter" class="form-select form-select-sm">
                    <option value="">All Roles</option>
                    <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                    <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Manager</option>
                    <option value="Sales Executive" selected="@(Model.RoleFilter == "Sales Executive")">Sales Executive</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    <option value="locked" selected="@(Model.StatusFilter == "locked")">Locked Out</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Department</th>
                    <th>Role</th>
                    <th>Account Status</th>
                    <th>Lockout Status</th>
                    <th>Reporting Manager</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold text-dark">@u.FullName</div>
                            <small class="text-muted">@u.Email</small>
                        </td>
                        <td>@(u.Department ?? "-")</td>
                        <td>
                            <span class="badge @(u.Role == "Admin" ? "bg-danger" : u.Role == "Manager" ? "bg-primary" : "bg-success") badge-status">
                                @u.Role
                            </span>
                        </td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">
                                @(u.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-lock-fill me-1"></i> LOCKED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Normal</span>
                            }
                        </td>
                        <td>@(u.ManagerName ?? "-")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Edit User">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </a>
                                @if (u.IsLockedOut)
                                {
                                    <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Unlock user account?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-warning" title="Unlock Account">
                                            <i class="bi bi-unlock"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Change user active status?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
