@model AcxiomCRM.Services.PaginatedList<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "System Audit Trail";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">System Audit Trail</h3>
        <p class="text-muted small mb-0">Immutable, append-only log of security authentications, permission modifications, and CRM operations</p>
    </div>
    <span class="badge bg-dark p-2">
        <i class="bi bi-shield-check me-1"></i> Tamper-Evident System Audit
    </span>
</div>

<!-- Search & Filter Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Search User/Details/Record</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="User, keyword, or ID..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Entity Module</label>
                <select name="entityFilter" class="form-select form-select-sm">
                    <option value="">All Entities</option>
                    <option value="Auth" selected="@(ViewBag.EntityFilter == "Auth")">Authentication</option>
                    <option value="Security" selected="@(ViewBag.EntityFilter == "Security")">Security</option>
                    <option value="User" selected="@(ViewBag.EntityFilter == "User")">User</option>
                    <option value="Customer" selected="@(ViewBag.EntityFilter == "Customer")">Customer</option>
                    <option value="Lead" selected="@(ViewBag.EntityFilter == "Lead")">Lead</option>
                    <option value="Opportunity" selected="@(ViewBag.EntityFilter == "Opportunity")">Opportunity</option>
                    <option value="FollowUp" selected="@(ViewBag.EntityFilter == "FollowUp")">Follow-Up</option>
                    <option value="Activity" selected="@(ViewBag.EntityFilter == "Activity")">Activity</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Action</label>
                <input type="text" name="actionFilter" value="@ViewBag.ActionFilter" class="form-control form-control-sm" placeholder="Login, Create, Update..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small">From Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">To Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100" title="Apply Filter">
                    <i class="bi bi-filter"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Logs Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Record ID</th>
                    <th>Details & Values</th>
                    <th>Client IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap small text-muted">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="fw-semibold">@(log.UserName ?? "Anonymous/System")</td>
                        <td>
                            <span class="badge @(log.Action.Contains("Lockout") || log.Action.Contains("Failed") ? "bg-danger" : log.Action.Contains("Login") ? "bg-success" : log.Action.Contains("Convert") ? "bg-primary" : "bg-secondary")">
                                @log.Action
                            </span>
                        </td>
                        <td><span class="badge bg-light text-dark border">@log.EntityName</span></td>
                        <td><code>@(log.RecordId ?? "-")</code></td>
                        <td class="small text-truncate" style="max-width: 380px;" title="@log.Details">
                            @(log.Details ?? log.NewValue ?? "-")
                        </td>
                        <td class="small text-muted">@(log.IpAddress ?? "127.0.0.1")</td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center py-5 text-muted">No audit events match your search.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @Model.PageIndex of @Model.TotalPages (@Model.TotalCount total events)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-search="@ViewBag.Search" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-actionFilter="@ViewBag.ActionFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-actionFilter="@ViewBag.ActionFilter">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-search="@ViewBag.Search" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-actionFilter="@ViewBag.ActionFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
