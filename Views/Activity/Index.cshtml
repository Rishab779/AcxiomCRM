@model AcxiomCRM.ViewModels.ActivityListViewModel
@{
    ViewData["Title"] = "CRM Activities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Sales Activity Log</h3>
        <p class="text-muted small mb-0">Audit history of client phone calls, meetings, email correspondence, and tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-clock-history me-1"></i> Log Activity
    </a>
</div>

<!-- Filter Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Search Subject/Notes</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Activity Type</label>
                <select name="typeFilter" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Task" selected="@(Model.TypeFilter == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Assigned Owner</label>
                <select name="assignedToFilter" asp-items="Model.UsersList" class="form-select form-select-sm">
                    <option value="">All Owners</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Linked Record</th>
                    <th>Activity Date</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Activities.Items)
                {
                    <tr>
                        <td>
                            <span class="badge @(a.ActivityType == "Call" ? "bg-primary" : a.ActivityType == "Meeting" ? "bg-success" : a.ActivityType == "Email" ? "bg-info text-dark" : "bg-secondary")">
                                @a.ActivityType
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@a.ActivityId" class="fw-semibold text-decoration-none">
                                @a.Subject
                            </a>
                            @if (!string.IsNullOrEmpty(a.Description))
                            {
                                <div class="small text-muted text-truncate" style="max-width: 300px;">@a.Description</div>
                            }
                        </td>
                        <td>
                            @if (a.Customer != null)
                            {
                                <a asp-controller="Customer" asp-action="Details" asp-route-id="@a.CustomerId" class="small text-decoration-none">
                                    <i class="bi bi-people me-1"></i>@a.Customer.CustomerName
                                </a>
                            }
                            else if (a.Lead != null)
                            {
                                <a asp-controller="Lead" asp-action="Details" asp-route-id="@a.LeadId" class="small text-decoration-none">
                                    <i class="bi bi-funnel me-1"></i>@a.Lead.LeadName
                                </a>
                            }
                            else if (a.Opportunity != null)
                            {
                                <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@a.OpportunityId" class="small text-decoration-none">
                                    <i class="bi bi-graph-up me-1"></i>@a.Opportunity.OpportunityName
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td>@a.ActivityDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(a.Status == "Completed" ? "bg-success" : "bg-warning text-dark") badge-status">
                                @a.Status
                            </span>
                        </td>
                        <td><small class="text-muted">@(a.AssignedUser?.FullName ?? "Unassigned")</small></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@a.ActivityId" class="btn btn-outline-secondary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-outline-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Activities.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-clock-history fs-1 d-block mb-2 text-secondary"></i>
                            No activities found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Activities.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">
                Showing page @Model.Activities.PageIndex of @Model.Activities.TotalPages (@Model.Activities.TotalCount total records)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.Activities.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Activities.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-typeFilter="@Model.TypeFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.Activities.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Activities.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-typeFilter="@Model.TypeFilter">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Activities.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Activities.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-typeFilter="@Model.TypeFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
