@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = $"Customer - {Model.CustomerName}";
}

<!-- Customer Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">@Model.CustomerName</h3>
            <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Status</span>
            <span class="badge bg-light text-dark border">@Model.CustomerCode</span>
        </div>
        <p class="text-muted small mb-0 mt-1">
            <i class="bi bi-building me-1"></i>@(Model.CompanyName ?? "Individual Client") &bull; Created on @Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy") by @Model.CreatedBy
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Customer
        </a>
        <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-graph-up me-1"></i> + New Deal
        </a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> + Follow-Up
        </a>
        <a asp-controller="Activity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-clock-history me-1"></i> + Activity
        </a>
        @if (Model.Status == "Active")
        {
            <form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this customer?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm" title="Deactivate Customer">
                    <i class="bi bi-trash"></i>
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Customer Profile Card -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="bi bi-person-vcard me-2 text-primary"></i>Contact Information</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <small class="text-muted d-block">Email</small>
                        <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none">@Model.Email</a>
                    </li>
                    <li class="mb-2">
                        <small class="text-muted d-block">Phone</small>
                        <a href="tel:@Model.Phone" class="fw-semibold text-decoration-none">@Model.Phone</a>
                    </li>
                    <li class="mb-2">
                        <small class="text-muted d-block">Assigned Account Executive</small>
                        <span class="fw-semibold">@(Model.AssignedUser?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="mb-2">
                        <small class="text-muted d-block">Address</small>
                        <span>@(Model.Address ?? "-")</span>
                    </li>
                    <li class="mb-0">
                        <small class="text-muted d-block">City / State</small>
                        <span>@((Model.City != null || Model.State != null) ? $"{Model.City}, {Model.State}" : "-")</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Quick Summary Box -->
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body p-3">
                <h6 class="fw-bold mb-2 small text-uppercase text-secondary">Relationship Summary</h6>
                <div class="d-flex justify-content-between mb-1 small">
                    <span>Total Opportunities:</span>
                    <strong class="text-dark">@Model.Opportunities.Count</strong>
                </div>
                <div class="d-flex justify-content-between mb-1 small">
                    <span>Active Pipeline Value:</span>
                    <strong class="text-primary">$@Model.Opportunities.Where(o => o.Status == "Open").Sum(o => o.Amount).ToString("N0")</strong>
                </div>
                <div class="d-flex justify-content-between mb-1 small">
                    <span>Completed Won Deals:</span>
                    <strong class="text-success">$@Model.Opportunities.Where(o => o.Status == "Won").Sum(o => o.Amount).ToString("N0")</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Tabs for Related Deals, Follow-ups, Activities -->
    <div class="col-lg-8">
        <!-- Related Opportunities -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-graph-up me-2 text-primary"></i>Opportunities / Pipeline Deals</h6>
                <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">Add Deal</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Deal Name</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Close Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opp in Model.Opportunities)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">
                                        @opp.OpportunityName
                                    </a>
                                </td>
                                <td>$@opp.Amount.ToString("N0")</td>
                                <td>
                                    <span class="badge @(opp.Stage == "Won" ? "bg-success" : opp.Stage == "Lost" ? "bg-danger" : "bg-primary")">
                                        @opp.Stage
                                    </span>
                                </td>
                                <td>@opp.Probability%</td>
                                <td>@opp.ExpectedCloseDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Opportunities.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted small">No opportunities linked to this customer yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Related Follow-Ups -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2 text-primary"></i>Follow-Up Schedule</h6>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">Schedule</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Scheduled Date</th>
                            <th>Remarks</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps.OrderByDescending(f => f.FollowUpDate))
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                <td>@f.FollowUpDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="text-truncate" style="max-width: 250px;">@f.Remarks</td>
                                <td>
                                    <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Missed" ? "bg-danger" : "bg-info text-dark")">
                                        @f.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="FollowUp" asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.FollowUps.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No follow-ups recorded.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Related Activities -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Activity Log</h6>
                <a asp-controller="Activity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">Log Activity</a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var act in Model.Activities.OrderByDescending(a => a.ActivityDate))
                    {
                        <li class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge @(act.ActivityType == "Call" ? "bg-primary" : act.ActivityType == "Meeting" ? "bg-success" : act.ActivityType == "Email" ? "bg-info text-dark" : "bg-secondary") me-2">
                                        @act.ActivityType
                                    </span>
                                    <strong>@act.Subject</strong>
                                    @if (!string.IsNullOrEmpty(act.Description))
                                    {
                                        <p class="small text-muted mb-0 mt-1">@act.Description</p>
                                    }
                                </div>
                                <span class="small text-muted text-nowrap">@act.ActivityDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            </div>
                        </li>
                    }
                    @if (!Model.Activities.Any())
                    {
                        <li class="list-group-item text-center py-4 text-muted small">No activities logged yet.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
