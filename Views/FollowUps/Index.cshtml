@model AcxiomCRM.ViewModels.FollowUpListViewModel
@{
    ViewData["Title"] = "Sales Follow-Ups";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Follow-Up Schedule</h3>
        <p class="text-muted small mb-0">Never drop a lead: track upcoming, due today, and completed sales interactions</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Timeframe Quick Filter Buttons & Search -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Search Remarks/Client</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Timeframe</label>
                <select name="timeframeFilter" class="form-select form-select-sm">
                    <option value="">All Dates</option>
                    <option value="today" selected="@(Model.TimeframeFilter == "today")">Due Today</option>
                    <option value="upcoming" selected="@(Model.TimeframeFilter == "upcoming")">Upcoming</option>
                    <option value="overdue" selected="@(Model.TimeframeFilter == "overdue")">Overdue</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Assigned Owner</label>
                <select name="assignedToFilter" asp-items="Model.UsersList" class="form-select form-select-sm">
                    <option value="">All Owners</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Context / Account</th>
                    <th>Type</th>
                    <th>Scheduled Date</th>
                    <th>Remarks</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.FollowUps.Items)
                {
                    var isOverdue = f.FollowUpDate < DateTime.UtcNow && f.Status == "Planned";
                    var isToday = f.FollowUpDate.Date == DateTime.UtcNow.Date && f.Status == "Planned";

                    <tr class="@(isOverdue ? "table-danger" : isToday ? "table-warning" : "")">
                        <td>
                            @if (f.Customer != null)
                            {
                                <div>
                                    <i class="bi bi-people text-primary me-1"></i>
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@f.CustomerId" class="fw-semibold text-decoration-none">
                                        @f.Customer.CustomerName
                                    </a>
                                </div>
                            }
                            else if (f.Lead != null)
                            {
                                <div>
                                    <i class="bi bi-funnel text-info me-1"></i>
                                    <a asp-controller="Lead" asp-action="Details" asp-route-id="@f.LeadId" class="fw-semibold text-decoration-none">
                                        @f.Lead.LeadName
                                    </a>
                                </div>
                            }
                            else if (f.Opportunity != null)
                            {
                                <div>
                                    <i class="bi bi-graph-up text-success me-1"></i>
                                    <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@f.OpportunityId" class="fw-semibold text-decoration-none">
                                        @f.Opportunity.OpportunityName
                                    </a>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">General Follow-Up</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@f.FollowUpType</span>
                        </td>
                        <td>
                            <div class="fw-semibold @(isOverdue ? "text-danger" : isToday ? "text-warning-emphasis" : "text-dark")">
                                @f.FollowUpDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                            </div>
                            @if (isOverdue)
                            {
                                <span class="badge bg-danger">OVERDUE</span>
                            }
                            else if (isToday)
                            {
                                <span class="badge bg-warning text-dark">DUE TODAY</span>
                            }
                        </td>
                        <td class="text-truncate" style="max-width: 280px;" title="@f.Remarks">
                            @f.Remarks
                        </td>
                        <td>
                            <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Missed" ? "bg-danger" : f.Status == "Cancelled" ? "bg-secondary" : "bg-info text-dark") badge-status">
                                @f.Status
                            </span>
                        </td>
                        <td><small class="text-muted">@(f.AssignedUser?.FullName ?? "Unassigned")</small></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-outline-secondary btn-sm">
                                View / Complete
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.FollowUps.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-check fs-1 d-block mb-2 text-secondary"></i>
                            No follow-ups found for the selected filter.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.FollowUps.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">
                Showing page @Model.FollowUps.PageIndex of @Model.FollowUps.TotalPages (@Model.FollowUps.TotalCount total records)
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.FollowUps.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.FollowUps.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter" asp-route-timeframeFilter="@Model.TimeframeFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.FollowUps.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.FollowUps.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter" asp-route-timeframeFilter="@Model.TimeframeFilter">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.FollowUps.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.FollowUps.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter" asp-route-timeframeFilter="@Model.TimeframeFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
