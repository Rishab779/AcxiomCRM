@model AcxiomCRM.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Create Staff Account</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Users</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name <span class="required-indicator">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Robert Henderson" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address <span class="required-indicator">*</span></label>
                        <input asp-for="Email" class="form-control" placeholder="staff@acxiomcrm.local" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Temporary Password <span class="required-indicator">*</span></label>
                        <input asp-for="Password" class="form-control" placeholder="Min 8 characters (Uppercase, lowercase, digit, symbol)" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label">Assigned Role <span class="required-indicator">*</span></label>
                            <select asp-for="Role" asp-items="Model.RolesList" class="form-select"></select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">Department / Territory</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Midwest Enterprise" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ManagerId" class="form-label">Reporting Manager (for hierarchy scoping)</label>
                        <select asp-for="ManagerId" asp-items="Model.ManagersList" class="form-select">
                            <option value="">-- No Direct Manager --</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Create User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
