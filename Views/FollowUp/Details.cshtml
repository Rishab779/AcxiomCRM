@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Follow-Up Details";
    var isOverdue = Model.FollowUpDate < DateTime.UtcNow && Model.Status == "Planned";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0 fw-bold">Follow-Up #@Model.FollowUpId</h5>
                    <span class="badge @(Model.Status == "Completed" ? "bg-success" : Model.Status == "Missed" ? "bg-danger" : Model.Status == "Cancelled" ? "bg-secondary" : "bg-info text-dark")">
                        @Model.Status
                    </span>
                    @if (isOverdue)
                    {
                        <span class="badge bg-danger">OVERDUE</span>
                    }
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Schedule</a>
            </div>

            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Related Record:</div>
                    <div class="col-sm-8 fw-semibold">
                        @if (Model.Customer != null)
                        {
                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId">
                                <i class="bi bi-people me-1"></i> Customer: @Model.Customer.CustomerName
                            </a>
                        }
                        else if (Model.Lead != null)
                        {
                            <a asp-controller="Lead" asp-action="Details" asp-route-id="@Model.LeadId">
                                <i class="bi bi-funnel me-1"></i> Lead: @Model.Lead.LeadName
                            </a>
                        }
                        else if (Model.Opportunity != null)
                        {
                            <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@Model.OpportunityId">
                                <i class="bi bi-graph-up me-1"></i> Deal: @Model.Opportunity.OpportunityName
                            </a>
                        }
                        else
                        {
                            <span>General Account</span>
                        }
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Interaction Type:</div>
                    <div class="col-sm-8"><span class="badge bg-light text-dark border">@Model.FollowUpType</span></div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Scheduled Time:</div>
                    <div class="col-sm-8 fw-bold @(isOverdue ? "text-danger" : "text-dark")">
                        @Model.FollowUpDate.ToLocalTime().ToString("dddd, MMMM dd, yyyy HH:mm")
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Agenda / Remarks:</div>
                    <div class="col-sm-8">@Model.Remarks</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Assigned Representative:</div>
                    <div class="col-sm-8 fw-semibold">@(Model.AssignedUser?.FullName ?? "Unassigned")</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.OutcomeNotes))
                {
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Outcome / Notes:</div>
                        <div class="col-sm-8 bg-light p-3 rounded">@Model.OutcomeNotes</div>
                    </div>
                }

                @if (Model.CompletedDate.HasValue)
                {
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Completed On:</div>
                        <div class="col-sm-8 text-success fw-semibold">@Model.CompletedDate.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                }
            </div>

            <!-- Action Panels for Planned Status -->
            @if (Model.Status == "Planned")
            {
                <div class="card-footer bg-light p-4">
                    <div class="row g-3">
                        <!-- Complete Follow Up Form -->
                        <div class="col-md-6 border-end">
                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-check-circle me-1"></i> Complete Follow-Up</h6>
                            <form asp-action="Complete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="FollowUpId" value="@Model.FollowUpId" />
                                <div class="mb-2">
                                    <textarea name="OutcomeNotes" class="form-control form-control-sm" rows="3" placeholder="Enter discussion summary or next action outcome..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-success btn-sm w-100">
                                    <i class="bi bi-check-lg me-1"></i> Mark as Completed
                                </button>
                            </form>
                        </div>

                        <!-- Reschedule Follow Up Form -->
                        <div class="col-md-6">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-calendar-event me-1"></i> Reschedule Follow-Up</h6>
                            <form asp-action="Reschedule" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="FollowUpId" value="@Model.FollowUpId" />
                                <div class="mb-2">
                                    <input type="datetime-local" name="NewFollowUpDate" class="form-control form-control-sm" required />
                                </div>
                                <div class="mb-2">
                                    <input type="text" name="Remarks" class="form-control form-control-sm" placeholder="Reason for reschedule (optional)" />
                                </div>
                                <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                                    <i class="bi bi-clock-history me-1"></i> Update Schedule
                                </button>
                            </form>

                            <hr class="my-3" />
                            <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this follow up?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.FollowUpId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-x-circle me-1"></i> Cancel Follow-Up
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
