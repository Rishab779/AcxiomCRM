@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = $"Opportunity - {Model.OpportunityName}";
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">@Model.OpportunityName</h3>
            <span class="badge @(Model.Stage == "Won" ? "bg-success" : Model.Stage == "Lost" ? "bg-danger" : "bg-primary")">
                @Model.Stage
            </span>
            <span class="badge bg-light text-dark border">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0 mt-1">
            <i class="bi bi-building me-1"></i> Customer:
            <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-semibold text-decoration-none">
                @Model.Customer.CustomerName
            </a>
            &bull; Created @Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Deal
        </a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> + Follow-Up
        </a>
        <a asp-controller="Activity" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-clock-history me-1"></i> + Activity
        </a>
    </div>
</div>

<!-- Quick Stage Advancement Bar -->
@if (Model.Status == "Open")
{
    <div class="card mb-4 bg-light border-0 shadow-sm">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="small fw-semibold text-secondary">
                <i class="bi bi-arrow-right me-1"></i> Fast Stage Progression:
            </div>
            <div class="btn-group btn-group-sm">
                @if (Model.Stage == "Qualification")
                {
                    <form asp-action="ChangeStage" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OpportunityId" />
                        <input type="hidden" name="stage" value="Proposal" />
                        <button type="submit" class="btn btn-outline-primary">Move to Proposal</button>
                    </form>
                }
                @if (Model.Stage == "Proposal" || Model.Stage == "Qualification")
                {
                    <form asp-action="ChangeStage" method="post" class="d-inline ms-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OpportunityId" />
                        <input type="hidden" name="stage" value="Negotiation" />
                        <button type="submit" class="btn btn-outline-warning text-dark">Move to Negotiation</button>
                    </form>
                }
                <form asp-action="ChangeStage" method="post" class="d-inline ms-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OpportunityId" />
                    <input type="hidden" name="stage" value="Won" />
                    <button type="submit" class="btn btn-success"><i class="bi bi-trophy me-1"></i> Mark Won</button>
                </form>
                <form asp-action="ChangeStage" method="post" class="d-inline ms-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OpportunityId" />
                    <input type="hidden" name="stage" value="Lost" />
                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i> Mark Lost</button>
                </form>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Deal Financials Card -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="bi bi-currency-dollar me-2 text-primary"></i>Deal Financials & Metrics</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <small class="text-muted d-block">Contract Value</small>
                        <span class="fs-4 fw-bold text-dark">$@Model.Amount.ToString("N0")</span>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Win Probability</small>
                        <div class="progress mt-1 mb-1" style="height: 10px;">
                            <div class="progress-bar @(Model.Probability >= 70 ? "bg-success" : Model.Probability >= 40 ? "bg-primary" : "bg-warning")"
                                 role="progressbar" style="width: @(Model.Probability)%"></div>
                        </div>
                        <span class="small fw-semibold">@Model.Probability% estimated win likelihood</span>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Weighted Forecast Value</small>
                        <span class="fs-5 fw-bold text-primary">$@Model.WeightedAmount.ToString("N0")</span>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Expected Target Close Date</small>
                        <span class="fw-semibold">@Model.ExpectedCloseDate.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                    </li>
                    <li class="mb-0">
                        <small class="text-muted d-block">Deal Owner</small>
                        <span class="fw-semibold">@(Model.AssignedUser?.FullName ?? "Unassigned")</span>
                    </li>
                </ul>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-card-text me-2 text-primary"></i>Deal Notes</h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-0">@Model.Notes</p>
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Follow-ups & Activities -->
    <div class="col-lg-8">
        <!-- Follow-Ups -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2 text-primary"></i>Follow-Up Schedule</h6>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-primary btn-sm">Schedule</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Date & Time</th>
                            <th>Remarks</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                <td>@f.FollowUpDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="text-truncate" style="max-width: 250px;">@f.Remarks</td>
                                <td><span class="badge bg-info text-dark">@f.Status</span></td>
                                <td class="text-end">
                                    <a asp-controller="FollowUp" asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-secondary">View</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.FollowUps.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No follow-ups recorded for this deal.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Activities -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Deal Engagement Activities</h6>
                <a asp-controller="Activity" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-primary btn-sm">Log Activity</a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var act in Model.Activities)
                    {
                        <li class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge bg-secondary me-2">@act.ActivityType</span>
                                    <strong>@act.Subject</strong>
                                    @if (!string.IsNullOrEmpty(act.Description))
                                    {
                                        <p class="small text-muted mb-0 mt-1">@act.Description</p>
                                    }
                                </div>
                                <span class="small text-muted">@act.ActivityDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            </div>
                        </li>
                    }
                    @if (!Model.Activities.Any())
                    {
                        <li class="list-group-item text-center py-4 text-muted small">No engagement activities logged yet.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
